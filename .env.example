# Schwab Trader API credentials — copy to .env and fill in. NEVER commit the real .env.
# Same registered app as ../trade-log/ (Schwab apps are per-person, not per-project) — copy the
# SAME values from trade-log/.env, including SCHWAB_CALLBACK_URL (it must exactly match what's
# registered on the app at https://developer.schwab.com — you can't pick a different port here).
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# Where schwab-py caches THIS project's OWN OAuth token (gitignored). Separate from trade-log's
# token file — same app, but a distinct consent/session per project.
SCHWAB_TOKEN_PATH=.schwab_token.json

# Human-readable account names, 'last4:Label' comma-separated. Schwab's API only reports
# CASH/MARGIN — it has no field saying which account is the Roth IRA vs the individual.
ACCOUNT_LABELS=1234:Individual,5678:Roth IRA

